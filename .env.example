# Copy to .env (gitignored). No secrets here – secrets live in ./secrets (scripts/init-secrets.sh).
PT_ENV=prod
PT_SITE_ADDRESS=localhost
PT_TLS_MODE=internal
PT_HTTPS_PORT=8443
PT_ALLOWED_ORIGINS=https://localhost:8443
PT_ADMIN_USER=admin
# SEC EDGAR fair-access policy: contact e-mail sent in the User-Agent to sec.gov (empty = EDGAR disabled)
PT_SEC_CONTACT=
# Claude cost guard: shared USD budget per calendar month (chart analyses + reports) and daily limits.
# API key: ./scripts/set-secret.sh anthropic_api_key
PT_AI_MONTHLY_BUDGET_USD=25
PT_AI_DAILY_LIMIT=30
PT_AI_REPORT_DAILY_LIMIT=5

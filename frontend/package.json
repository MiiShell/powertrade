{
  "name": "powertrade-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:worker && next dev",
    "build": "npm run build:worker && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:worker": "esbuild pine/worker.ts --bundle --format=iife --platform=browser --target=es2022 --minify --legal-comments=external --outfile=public/pine-worker.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "next": "16.4.5",
    "pinets": "0.13.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3"
  }
}
